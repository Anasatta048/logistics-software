# Production env for Docker / Coolify. Copy to .env (compose) or set in the Coolify UI.
# Generate APP_KEY:  docker run --rm php:8.2-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_NAME="Dreamelect Logistics"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://logistics.example.com
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=dreamelect_logistics
DB_USERNAME=dreamelect
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_SECURE_COOKIE=true

MAIL_MAILER=log

# Maps: google | geoapify (blank = whichever has a key, Geoapify first)
MAP_PROVIDER=
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
GEOAPIFY_API_KEY=
GEOAPIFY_TILES_KEY=
GHOSTSCRIPT_BINARY=gs

# Live notifications (Laravel Reverb runs inside the app container; nginx proxies /app/).
# Use any random strings for the key and secret.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=dreamelect
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Leave REVERB_PUBLIC_* unset: the browser then uses the page's own host over wss.

APP_PORT=8080
