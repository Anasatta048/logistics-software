APP_NAME="Logistics SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug



# --- Database (MySQL) -------------------------------------------------------
# Create the schema once before running migrations:
#   CREATE DATABASE logistics_saas CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# Real credentials live only in .env, which is git-ignored. Never commit them.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=logistics_saas
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Map provider: google | geoapify (blank = whichever has a key, Geoapify first)
MAP_PROVIDER=
# Server key: Places API (New), Geocoding API, Routes API. Restrict by server IP.
GOOGLE_MAPS_API_KEY=
# Browser key: Maps JavaScript API only. Restrict by HTTP referrer (your domain).
GOOGLE_MAPS_BROWSER_KEY=
# Truck routing (miles + the road line on the map) and the fallback lookup
GEOAPIFY_API_KEY=
GEOAPIFY_TILES_KEY=
# Optional: PDFs are compressed only when Ghostscript is installed (the Docker image has it)
GHOSTSCRIPT_BINARY=
VITE_APP_NAME="${APP_NAME}"

# Live notifications (Laravel Reverb). Run locally with: php artisan reverb:start
REVERB_APP_ID=dreamelect
REVERB_APP_KEY=dreamelectlocalkey
REVERB_APP_SECRET=dreamelectlocalsecret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_PUBLIC_HOST=127.0.0.1
REVERB_PUBLIC_PORT=8080
REVERB_PUBLIC_SCHEME=http

# --- SaaS platform ----------------------------------------------------------
# Who gets the "new access request" email (defaults to the first super admin).
SAAS_NOTIFY_EMAIL=
SAAS_SUPPORT_EMAIL=

# Subscription payments (a method with no value is not offered to workspaces)
SAAS_BANK_NAME=
SAAS_BANK_ACCOUNT_TITLE=
SAAS_BANK_ACCOUNT_NUMBER=
SAAS_BANK_IBAN=
SAAS_RAAST_ID=
SAAS_JAZZCASH_NUMBER=
SAAS_EASYPAISA_NUMBER=
SAAS_LEGAL_NAME=
SAAS_LEGAL_ADDRESS=
SAAS_REFUND_DAYS=7

# Backups (nightly at 03:00 via the scheduler). On XAMPP/Windows point these at its bin folder.
BACKUP_KEEP_DAYS=14
BACKUP_OFFSITE_DISK=
BACKUP_MYSQLDUMP=mysqldump
BACKUP_MYSQL=mysql

# Error tracking: leave empty to disable. Get a DSN from sentry.io (Laravel project).
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
